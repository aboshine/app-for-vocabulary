# App database connection (use a pooled URL in production, e.g. Neon/Supabase/Vercel pooler)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/korean_vocab?schema=public"

# Direct database connection for Prisma Migrate (no PgBouncer)
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/korean_vocab?schema=public"

# AI (Read / Learn / "Fill with AI"). Free key: https://aistudio.google.com/apikey
# Without a key the app still works; AI buttons show a "not connected" message.
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_MID_MODEL=gemini-3.6-flash   # tried between the two when the main model is overloaded; "" turns it off
# APP_TIMEZONE=Asia/Seoul        # which calendar day a reading text belongs to

# Alternative provider (paid, cheap):
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Telegram reminders (optional). Create a bot with @BotFather, put its token here,
# then press "Connect" in Settings. Vercel Cron calls /api/cron/remind (see vercel.json).
# TELEGRAM_BOT_TOKEN=
# CRON_SECRET=                   # any long random string; Vercel sends it to the cron route
# APP_URL=https://your-app.vercel.app   # link added to reminders (defaults to the Vercel production URL)

# Password for the whole app (recommended on a public URL). Asked once per device.
# Without it anyone who has the link can open and change the deck.
# APP_PASSWORD=
