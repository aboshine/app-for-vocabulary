# App database connection (use a pooled URL in production, e.g. Neon/Supabase/Vercel pooler)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/korean_vocab?schema=public"

# Direct database connection for Prisma Migrate (no PgBouncer)
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/korean_vocab?schema=public"

# AI (Read / Learn / "Fill with AI"). Free key: https://aistudio.google.com/apikey
# Without a key the app still works; AI buttons show a "not connected" message.
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# APP_TIMEZONE=Asia/Seoul        # which calendar day a reading text belongs to

# Alternative provider (paid, cheap):
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
