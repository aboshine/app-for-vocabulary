generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id        String       @id @default(cuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  words     Vocabulary[]
  grammars  Grammar[]
}

model Vocabulary {
  id                 String    @id @default(cuid())
  korean             String
  meaning            String
  exampleSentence    String    @default("")
  exampleTranslation String    @default("")
  notes              String    @default("")
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags               String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  learningState      String    @default("new")
  reviewCount        Int       @default(0)
  againCount         Int       @default(0)
  hardCount          Int       @default(0)
  goodCount          Int       @default(0)
  easyCount          Int       @default(0)
  nextReviewAt       DateTime  @default(now())
  lastReviewedAt     DateTime?
  intervalMinutes    Int       @default(0)
  /// "manual" | "curriculum" | "ai" | "reading"
  source             String    @default("manual")
  /// e.g. "TOPIK1", "TOPIK2"; empty for words added by hand
  level              String    @default("")
  /// language of `meaning` ("ru" | "en" | "kk"; "" = typed by hand, unknown)
  meaningLang        String    @default("")
  reviews            Review[]

  @@index([nextReviewAt])
  @@index([learningState])
  @@index([categoryId])
  @@index([korean])
}

model Review {
  id             String     @id @default(cuid())
  vocabularyId   String
  vocabulary     Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  rating         String
  direction      String
  intervalBefore Int
  intervalAfter  Int
  createdAt      DateTime   @default(now())

  @@index([createdAt])
  @@index([vocabularyId])
}

model Grammar {
  id              String           @id @default(cuid())
  title           String
  meaning         String
  explanation     String           @default("")
  structure       String           @default("")
  examples        String           @default("[]")
  notes           String           @default("")
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            String           @default("")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  learningState   String           @default("new")
  reviewCount     Int              @default(0)
  againCount      Int              @default(0)
  hardCount       Int              @default(0)
  goodCount       Int              @default(0)
  easyCount       Int              @default(0)
  nextReviewAt    DateTime         @default(now())
  lastReviewedAt  DateTime?
  intervalMinutes Int              @default(0)
  reviews         GrammarReview[]

  @@index([nextReviewAt])
  @@index([learningState])
  @@index([categoryId])
  @@index([title])
}

model GrammarReview {
  id             String   @id @default(cuid())
  grammarId      String
  grammar        Grammar  @relation(fields: [grammarId], references: [id], onDelete: Cascade)
  rating         String
  intervalBefore Int
  intervalAfter  Int
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([grammarId])
}

model AppSettings {
  id                String   @id
  dailyNewWordLimit Int      @default(10)
  sessionLimit      String   @default("10")
  defaultMode       String   @default("mixed")
  mixedModes        String   @default("")
  includeNew        Boolean  @default(true)
  defaultCategoryId String   @default("")
  dailyReviewTarget Int      @default(20)
  /// AI reading / word packs (see src/lib/ai-settings.ts)
  aiLevel           Int      @default(2)
  aiLang            String   @default("ru")
  currentTheme      String   @default("")
  targetsPerText    Int      @default(8)
  packSize          Int      @default(8)
  /// Study plan + reminders (see src/lib/plan.ts, src/lib/telegram.ts)
  dailyMinutes      Int      @default(15)
  telegramChatId    String   @default("")
  remindersOn       Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

/// One AI-generated graded reading text. `payload` holds the JSON from lib/ai/prompts (ReadingPayload).
model DailyText {
  id          String    @id @default(cuid())
  /// Local calendar day (YYYY-MM-DD, APP_TIMEZONE) the text belongs to
  day         String
  level       String
  theme       String    @default("")
  title       String
  payload     String
  /// Comma-separated Vocabulary ids the text was built around
  targetIds   String    @default("")
  model       String    @default("")
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([day])
}

/// Weekly self-test. `questions` / `summary` hold JSON (see src/lib/weekly.ts).
model WeeklyCheck {
  id          String    @id @default(cuid())
  questions   String
  summary     String    @default("")
  score       Int       @default(0)
  total       Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

/// AI grammar lesson for one syllabus pattern. `payload` is LessonPayload JSON (src/lib/ai/tutor-prompts.ts).
model GrammarLesson {
  id          String    @id @default(cuid())
  /// key from src/data/grammar-syllabus.ts
  patternKey  String
  title       String
  lang        String    @default("")
  payload     String
  /// Grammar card created when the lesson was finished
  grammarId   String    @default("")
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([patternKey])
}

/// Saved AI answers (sentence breakdowns, word help) so the same question is not paid for twice.
model TutorCache {
  /// sha256 of task + language + level + input
  key       String   @id
  task      String
  payload   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One writing exercise: the learner's sentences and the teacher's corrections (JSON).
model WritingEntry {
  id        String   @id @default(cuid())
  /// comma-separated Vocabulary ids the task asked for
  wordIds   String   @default("")
  text      String
  feedback  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
